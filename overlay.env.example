# Firm-specific values. bootstrap.sh copies this to ~/ebs/.claude/overlay.env on first
# run; edit THAT copy. The real file is never committed to the generic repo.
# Sourced by bash: quote values, no spaces around '='.

WORKSPACE_MODE=interactive              # interactive (acceptEdits) | unattended (bypassPermissions)
GH_HOST=                                # GitHub Enterprise host for gh, e.g. github.example.com
JIRA_KEY_REGEX='[A-Z][A-Z0-9]+-[0-9]+'  # commit subjects must start with this
PROTECTED_BRANCHES='main master develop release'
LOCAL_ONLY_PATTERNS='CLAUDE.local.md settings.local.json overlay.env'
TEAMS_WEBHOOK_URL=                      # empty = notifications off
CDP_URL=http://127.0.0.1:9222           # browser sidecar DevTools endpoint
PYPI_INDEX_URL=                         # internal PyPI mirror (simple index); empty = pip defaults
RTK_VENDORED_REPO=                      # git URL of an rtk tree vendored for offline cargo builds; empty = skip
PERSIST_DIR="${PERSIST_DIR:-$HOME/ebs}"
PROJECTS_DIR="${PROJECTS_DIR:-$PERSIST_DIR/projects}"
USER_DISPLAY_NAME=Felix
