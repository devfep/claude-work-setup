{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": true,
  "cleanupPeriodDays": 365,
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "defaultMode": "__DEFAULT_MODE__",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/ebs/.shellrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/ebs/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.claudectl-envvars.sh)",
      "Read(~/ebs/.identity-proxy/**)",
      "Read(~/ebs/.claude/overlay.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/block-rm-rf.sh" },
          { "type": "command", "command": "~/.claude/hooks/block-protected-push.sh" },
          { "type": "command", "command": "~/.claude/hooks/require-jira-prefix.sh" },
          { "type": "command", "command": "~/.claude/hooks/block-local-only.sh" },
          { "type": "command", "command": "~/.claude/hooks/enforce-package-manager.sh" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/protect-files.sh" }
        ]
      }
    ],
    "Notification": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "~/.claude/hooks/teams-notify.sh" } ] }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/teams-notify.sh" },
          {
            "type": "prompt",
            "prompt": "Review the assistant's final response. Reject it ONLY if the assistant is rationalizing INCOMPLETE WORK IT SHOULD HAVE FINISHED. Common reject-worthy patterns: claiming issues are 'pre-existing' or 'out of scope' to avoid fixing them, saying there are 'too many issues' to address, deferring work to an unrequested follow-up, listing problems without fixing them, or skipping test/lint failures with excuses. DO NOT REJECT if the assistant is legitimately waiting on user input that only the user can provide (clarifying questions, subjective preferences, self-assessments like confidence ratings, approval of a draft, Socratic dialogue answers, or asking the user to choose between options). Those are gates, not deferrals. If a real rationalization pattern is present, respond {\"ok\": false, \"reason\": \"You are rationalizing incomplete work. [specific issue]. Go back and finish.\"}. Otherwise respond {\"ok\": true}."
          }
        ]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "modern-python@trailofbits": true,
    "gh-cli@trailofbits": true,
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": { "source": { "source": "github", "repo": "obra/superpowers-marketplace" } },
    "trailofbits": { "source": { "source": "github", "repo": "trailofbits/skills" } },
    "pstack-claude": { "source": { "source": "github", "repo": "hadifarnoud/pstack-claude" } }
  }
}
